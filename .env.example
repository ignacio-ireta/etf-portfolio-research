# Environment template for etf-portfolio-research.
# Copy to `.env` (git-ignored) and fill in as needed. The core pipeline is
# local-first and networked only for the `ingest` stage; secrets below are
# optional and only required for the providers/features you opt into.

# Tiingo market-data provider (only needed when data.provider: tiingo).
# Get a key at https://www.tiingo.com/ ; never commit the real value.
TIINGO_API_KEY=

# MLflow tracking backend (only used when ml.tracking.enable_mlflow: true).
# Defaults to a local ./mlruns directory when unset.
# MLFLOW_TRACKING_URI=
