+            f"[{ci_lower:+.2f}, {ci_upper:+.2f}] "
+            f"({int(sharpe_uncertainty['n_resamples'])} stationary-bootstrap resamples, "
+            f"mean block {int(sharpe_uncertainty['mean_block_length'])} trading days, "
